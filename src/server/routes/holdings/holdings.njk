{% extends 'layouts/page.njk' %}

{% from "sortable-paginated-table/macro.njk" import sortablePaginatedTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Find a holding</h1>

      <div class="govuk-form-group">
        <label class="govuk-label" for="search-holdings">Search by CPH number, holding name, herd mark, town or county, or postcode</label>
        {% if not searched %}
        <div id="search-holdings-hint" class="govuk-hint">
          <p class="govuk-!-margin-bottom-1">You can search using:</p>
          <ul class="govuk-list govuk-list--bullet">
            <li>CPH number, for example 12/345/0001</li>
            <li>holding name, for example Oakfield Farm</li>
            <li>herd mark, for example UK 123456</li>
            <li>town or county, for example Cumbria</li>
            <li>postcode, for example SY4 1AB</li>
          </ul>
        </div>
        {% endif %}

        <form method="GET" class="lis-search-form">
          <div class="lis-search-form__wrapper">
            <input
              class="govuk-input lis-search-form__input"
              type="search"
              id="search-holdings"
              name="search"
              {% if not searched %}aria-describedby="search-holdings-hint"{% endif %}
              maxlength="100"
              value="{{ search }}"
            >
            <div class="lis-search-form__submit-wrapper">
              <button class="lis-search-form__submit" type="submit">
                <svg class="lis-search-form__icon" width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                  <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
                  <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line>
                </svg>
                <span class="govuk-visually-hidden">Search</span>
              </button>
            </div>
          </div>
        </form>
      </div>

      {% if searched %}
        <h2 class="govuk-body govuk-!-text-break-word"><strong>{{ total }}</strong> {% if total == 1 %}holding matches{% else %}holdings match{% endif %} ‘{{ search }}’</h2>
        <p class="govuk-body"><a class="govuk-link" href="/holdings">Clear search</a></p>
      {% endif %}
    </div>
  </div>

  {% if searched and total > 0 %}
    {%- set rows = [] -%}
    {%- for holding in results -%}
      {%- set cphHtml -%}
        <a class="govuk-link" href="{{ holding.href }}">{{ holding.cph }}</a>
      {%- endset -%}
      {%- set _ = rows.push([
        { html: cphHtml },
        { text: holding.location },
        { text: holding.status }
      ]) -%}
    {%- endfor -%}

    {{ sortablePaginatedTable({
      caption: "Holdings search results",
      columns: [
        { text: "CPH" },
        { text: "Location" },
        { text: "Status" }
      ],
      rows: rows,
      firstCellIsHeader: true,
      baseHref: "/holdings",
      query: { search: search },
      pagination: pagination
    }) }}
  {% endif %}
{% endblock %}
